###############################################################################
# PAPI — шаблон настроек окружения
#
# Скопируйте этот файл в .env и заполните ВСЕ значения своими данными:
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux/macOS)
#
# Файл .env хранит все пароли и секретные фразы, он НЕ должен попадать в git
# (уже добавлен в .gitignore).
###############################################################################

# ---------------------------------------------------------------------------
# PostgreSQL (используется docker-compose для создания базы данных)
# ---------------------------------------------------------------------------
# Имя пользователя суперпользователя БД
POSTGRES_USER=postgres
# Пароль БД — измените на надёжный пароль!
POSTGRES_PASSWORD=-------------
# Имя базы данных
POSTGRES_DB=papidb
# Порт БД на хосте (доступен только с localhost)
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# База данных (для локальной разработки БЕЗ docker compose)
# Внутри docker compose DATABASE_URL формируется автоматически из POSTGRES_*
# и указывает на сервис "db", это значение используется только при запуске
# бэкенда напрямую (python main.py).
# ---------------------------------------------------------------------------
# URL БД для локального запуска бэкенда напрямую (python main.py).
# Драйвер +psycopg2 обязателен: SQLAlchemy 2 без него пытается взять psycopg v3,
# которого нет в requirements (ошибка "No module named 'psycopg'").
# Пароль здесь тот же, что в POSTGRES_PASSWORD выше — меняйте его в обоих местах
# или используйте подстановку: postgresql+psycopg2://papi:${POSTGRES_PASSWORD}@localhost:5432/papiDB
DATABASE_URL=postgresql+psycopg2://postgres:---------------@localhost:5432/papidb

# ---------------------------------------------------------------------------
# JWT — подпись токенов доступа
# ---------------------------------------------------------------------------
# КЛЮЧ ПОДПИСИ — сгенерируйте уникальный случайный ключ, например:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# НИКОГДА не используйте ключ из примера в продакшене!
SECRET_KEY=your-super-secret-key-change-in-production-use-strong-random-key-here-123456789
# Алгоритм подписи JWT
ALGORITHM=HS256
# Время жизни access-токена в минутах (1440 = 24 часа)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# Сервер (локальный запуск бэкенда; в docker compose порт задаётся отдельно)
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8888

# ---------------------------------------------------------------------------
# CORS — список разрешённых источников через запятую
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Порты docker compose
# ---------------------------------------------------------------------------
# Публичный порт приложения (фронтенд + прокси API) — откройте в браузере http://localhost:80
APP_PORT=80
# Порт API на хосте для отладки (доступен только с localhost)
BACKEND_PORT=8888

# ---------------------------------------------------------------------------
# Внешние ссылки
# ---------------------------------------------------------------------------
# Базовый URL фронтенда — используется в QR-кодах инвентаризации и ссылках
FRONTEND_URL=http://localhost

# ---------------------------------------------------------------------------
# Email-уведомления (опционально; пусто = email-уведомления отключены)
# ---------------------------------------------------------------------------
# Вариант 1 (рекомендуемый): SMTP_*
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=

# Вариант 2 (альтернативный): MAIL_*
# MAIL_SERVER=smtp.yandex.ru
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=

# TLS/SSL настройки для SMTP (true/false)
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# ---------------------------------------------------------------------------
# MAX chat — уведомления в мессенджер (опционально; пусто = отключено)
# ---------------------------------------------------------------------------
# URL сервиса-шлюза для отправки сообщений
MAX_API_URL=
# Токен API шлюза MAX
MAX_API_TOKEN=
