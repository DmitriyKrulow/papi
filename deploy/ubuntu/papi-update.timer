[Unit]
# Автообновление PAPI из git-репозитория.
#
# Проверка:  systemctl list-timers papi-update.timer
# Лог:       journalctl -u papi-update -f
# Прогнать вручную: systemctl start papi-update.service
#
# Обновление молча ничего не ломает: update.sh сначала делает git reset --hard
# в отдельном рабочем дереве не требуется (каталог и есть рабочее дерево),
# но обязательно снимает дамп БД, а при ошибке сборки или ответа сервисов
# завершается ненулевым кодом - это видно в journalctl и в состоянии таймера.
Description=Ежеминутная проверка обновлений PAPI в git

[Timer]
# Первое срабатывание - через минуту после загрузки: сервер только поднялся,
# стоит сразу подтянуть изменения, накопившиеся за время простоя.
OnBootSec=1min
# Дальше - каждые 15 минут.
OnUnitActiveSec=15min
# Разброс, чтобы несколько серверов не ломились в git-хост одновременно.
RandomizedDelaySec=90
# Если сервер был выключен в момент срабатывания, выполнить задачу сразу
# после включения.
Persistent=true

[Install]
WantedBy=timers.target
