# Автостарт контейнеров и запуск скриптов деплоя не должны зависеть от того,
# на какой ОС сделали клон репозитория.
#
# Проблема без этого файла: git config core.autocrlf=true (типично для Windows)
# подменяет в рабочем каталоге LF на CRLF. Скрипт с CRLF в первой строке
# ("#!/bin/bash\r") на Ubuntu не запускается:
#   bash: ./update.sh: /bin/bash^M: bad interpreter
# а bash ругается на "syntax error near unexpected token $'{\r''".
#
# Поэтому для всех файлов, которые исполняются на Linux, фиксируем LF.
* text=auto

*.sh          text eol=lf
*.bash        text eol=lf
*.conf        text eol=lf
*.service     text eol=lf
*.timer       text eol=lf
*.env.example text eol=lf
.env.example  text eol=lf
docker-compose.yml   text eol=lf
docker-compose.yaml  text eol=lf
Dockerfile           text eol=lf
.gitignore           text eol=lf
.gitattributes       text eol=lf

# Windows-скрипты должны оставаться в CRLF: powershell.exe и планировщик
# задач Windows иначе спотыкаются о некоторые многострочные конструкции.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Бинарные форматы не нормализуем
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.woff2 binary
*.gz    binary
*.dump  binary
