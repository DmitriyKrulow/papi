# ============================================================
# Пример конфигурации cron для PAPI
# ============================================================
#
# Установка:
#   1. Отредактируйте пути ниже под вашу систему
#   2. Запустите: crontab -e
#   3. Вставьте нужные строки
#
# Формат cron:
#   ┌───────────── минута (0 - 59)
#   │ ┌───────────── час (0 - 23)
#   │ │ ┌───────────── день месяца (1 - 31)
#   │ │ │ ┌───────────── месяц (1 - 12)
#   │ │ │ │ ┌───────────── день недели (0 - 7) (0 и 7 - воскресенье)
#   │ │ │ │ │
#   * * * * * <команда>
# ============================================================

# ---------------------------------------------------------------------------
# Ежедневный бэкап в 2:00 ночи
# ---------------------------------------------------------------------------
0 2 * * * /path/to/papi/scripts/backup.sh >> /var/log/papi-backup.log 2>&1

# ---------------------------------------------------------------------------
# Автоматическое обновление из Git в 3:00 ночи (ежедневно)
# ---------------------------------------------------------------------------
0 3 * * * /path/to/papi/scripts/update_docker.sh >> /var/log/papi-docker-update.log 2>&1

# ---------------------------------------------------------------------------
# Еженедельный полный бэкап в воскресенье в 1:00 ночи
# (с хранением 90 дней)
# ---------------------------------------------------------------------------
0 1 * * 0 RETENTION_DAYS=90 /path/to/papi/scripts/backup.sh >> /var/log/papi-weekly-backup.log 2>&1

# ---------------------------------------------------------------------------
# Мониторинг здоровья сервиса (каждые 5 минут)
# ---------------------------------------------------------------------------
*/5 * * * * curl -f http://localhost:8888/docs > /dev/null 2>&1 || echo "$(date) - Backend down" >> /var/log/papi-health.log

# ---------------------------------------------------------------------------
# Очистка старых логов (ежемесячно в 4:00 утра 1-го числа)
# ---------------------------------------------------------------------------
0 4 1 * * find /var/log -name "papi-*.log" -mtime +30 -delete
