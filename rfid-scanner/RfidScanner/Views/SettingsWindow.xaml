<Window x:Class="RfidScanner.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RfidScanner.Models"
        Title="Настройки" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Подключение -->
                <TextBlock Text="Подключение к серверу" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="URL сервера:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="BackendUrlBox" 
                            Text="http://localhost:8080"/>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="API-ключ сканера:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="ApiKeyBox" 
                            Text="" Padding="5"/>
                </Grid>

                <!-- Режим сканера -->
                <TextBlock Text="Режим RFID-сканера" FontWeight="Bold" FontSize="14" Margin="0,10,0,10"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Тип:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="ScannerModeCombo" 
                             SelectedIndex="0" Margin="0,0,0,5">
                        <ComboBoxItem Content="HID (клавиатура)"/>
                        <ComboBoxItem Content="TCP/IP"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,15" x:Name="TcpSettingsPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="IP-адрес:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="TcpIpBox" Text="192.168.1.100"/>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Порт:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="TcpPortBox" Text="8000"/>
                </Grid>

                <!-- Опции -->
                <TextBlock Text="Опции" FontWeight="Bold" FontSize="14" Margin="0,10,0,10"/>
                
                <CheckBox x:Name="AutoSyncCheck" Content="Автоматическая синхронизация при подключении" 
                         Margin="0,5"/>
                <CheckBox x:Name="SoundCheck" Content="Звуковой сигнал при сканировании" 
                         Margin="0,5" IsChecked="True"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Сохранить" Width="100" Margin="0,0,10,0"
                   Click="SaveButton_Click"/>
            <Button Content="Отмена" Width="100"
                   Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
