<Window x:Class="RfidScanner.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RfidScanner.Models"
        Title="Настройки" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeBg}">
    
    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeWidgetInfoBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource ThemeScrollViewerBg}">
            <StackPanel>
                <!-- Подключение -->
                <TextBlock Text="Подключение к серверу" FontWeight="Bold" FontSize="14" 
                           Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="URL сервера:" VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeTextPrimary}"/>
                    <TextBox Grid.Column="1" x:Name="BackendUrlBox" 
                             Background="{DynamicResource ThemeInputBg}"
                             Foreground="{DynamicResource ThemeTextPrimary}"
                             BorderBrush="{DynamicResource ThemeInputBorder}"
                             BorderThickness="1"/>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="API-ключ сканера:" VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeTextPrimary}"/>
                    <TextBox Grid.Column="1" x:Name="ApiKeyBox" 
                             Background="{DynamicResource ThemeInputBg}"
                             Foreground="{DynamicResource ThemeTextPrimary}"
                             BorderBrush="{DynamicResource ThemeInputBorder}"
                             BorderThickness="1"
                             Padding="5"/>
                </Grid>

                <!-- Режим сканера -->
                <TextBlock Text="Режим RFID-сканера" FontWeight="Bold" FontSize="14" 
                           Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,10,0,10"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Тип:" VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeTextPrimary}"/>
                    <ComboBox Grid.Column="1" x:Name="ScannerModeCombo" 
                              SelectedIndex="0" Margin="0,0,0,5">
                        <ComboBoxItem Content="📡 RFID (клавиатура)"/>
                        <ComboBoxItem Content="📱 NFC (клавиатура)"/>
                        <ComboBoxItem Content="🌐 TCP/IP"/>
                        <ComboBoxItem Content="🔌 Serial (RS232)"/>
                    </ComboBox>
                </Grid>
                
                <!-- Индикатор выбранного режима -->
                <Border x:Name="ModeIndicatorBorder" Background="{DynamicResource ThemeWidgetInfoBg}" 
                        CornerRadius="8" Padding="12" Margin="0,0,0,15"
                        BorderThickness="1" BorderBrush="{DynamicResource ThemeBorderBrush}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock x:Name="ModeIndicatorIcon" Text="📡" FontSize="16" Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="ModeIndicatorText" Text="RFID-сканер (HID)" 
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeTextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,15" x:Name="TcpSettingsPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="IP-адрес:" VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeTextPrimary}"/>
                    <TextBox Grid.Column="1" x:Name="TcpIpBox" 
                             Background="{DynamicResource ThemeInputBg}"
                             Foreground="{DynamicResource ThemeTextPrimary}"
                             BorderBrush="{DynamicResource ThemeInputBorder}"
                             BorderThickness="1"
                             Text="192.168.1.100"/>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Порт:" VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeTextPrimary}"/>
                    <TextBox Grid.Column="1" x:Name="TcpPortBox" 
                             Background="{DynamicResource ThemeInputBg}"
                             Foreground="{DynamicResource ThemeTextPrimary}"
                             BorderBrush="{DynamicResource ThemeInputBorder}"
                             BorderThickness="1"
                             Text="8000"/>
                </Grid>

                <!-- Опции -->
                <TextBlock Text="Опции" FontWeight="Bold" FontSize="14" 
                           Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,10,0,10"/>
                
                <CheckBox x:Name="AutoSyncCheck" Content="Автоматическая синхронизация при подключении" 
                          Margin="0,5"
                          Foreground="{DynamicResource ThemeTextPrimary}"/>
                <CheckBox x:Name="SoundCheck" Content="Звуковой сигнал при сканировании" 
                          Margin="0,5" IsChecked="True"
                          Foreground="{DynamicResource ThemeTextPrimary}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Сохранить" Width="100" Margin="0,0,10,0"
                    Click="SaveButton_Click"
                    Background="{DynamicResource ThemeInfo}" Foreground="White"/>
            <Button Content="Отмена" Width="100"
                    Click="CancelButton_Click"
                    Background="{DynamicResource ThemeTextSecondary}" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
