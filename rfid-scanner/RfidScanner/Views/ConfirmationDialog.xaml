<Window x:Class="RfidScanner.Views.ConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение" Height="300" Width="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#E8F5E9" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="✅ Подтверждение проверки" FontSize="18" FontWeight="Bold" Foreground="#2E7D32"/>
                <TextBlock Text="Подтвердите, что актив найден и проверен." 
                          FontSize="13" Foreground="#388E3C" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Информация об активе -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" BorderThickness="1" BorderBrush="#E0E0E0" 
                       CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="RFID-метка:" FontWeight="Bold" Foreground="#616161"/>
                        <TextBlock Grid.Column="1" x:Name="RfidTagText" Text="—" FontSize="14"/>
                    </Grid>
                </Border>

                <Border Background="White" BorderThickness="1" BorderBrush="#E0E0E0" 
                       CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Название:" FontWeight="Bold" Foreground="#616161"/>
                        <TextBlock Grid.Column="1" x:Name="AssetNameText" Text="—" FontSize="14"/>
                    </Grid>
                </Border>

                <Border Background="White" BorderThickness="1" BorderBrush="#E0E0E0" 
                       CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Инв. номер:" FontWeight="Bold" Foreground="#616161"/>
                        <TextBlock Grid.Column="1" x:Name="InventoryNumberText" Text="—" FontSize="14"/>
                    </Grid>
                </Border>

                <!-- История проверок -->
                <Border Background="White" BorderThickness="1" BorderBrush="#E0E0E0" 
                       CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Последние проверки:" FontWeight="Bold" Foreground="#616161" Margin="0,0,0,8"/>
                        <TextBlock x:Name="HistoryText" Text="—" FontSize="13" Foreground="#757575" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Подтверждение -->
                <CheckBox x:Name="ConfirmCheckBox" Content="Я подтверждаю, что актив найден и соответствует данным" 
                         IsChecked="True" FontSize="13" Margin="0,10,0,0" Foreground="#424242"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Подтвердить" Click="ConfirmButton_Click" 
                   Background="#4CAF50" Foreground="White" Padding="20,8" Margin="0,0,10,0"
                   FontSize="13" x:Name="ConfirmBtn"/>
            <Button Content="Отмена" Click="CancelButton_Click" 
                   Background="#E0E0E0" Foreground="#424242" Padding="20,8"
                   FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
