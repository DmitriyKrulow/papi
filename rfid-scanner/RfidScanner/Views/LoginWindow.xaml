<Window x:Class="RfidScanner.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="400" Width="420" MinHeight="370"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeBg}">
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="PAPI RFID Scanner" FontSize="20" FontWeight="Bold" 
                       HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimary}"/>
            <TextBlock Text="Введите данные для входа" FontSize="12" 
                       HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Форма входа -->
        <StackPanel Grid.Row="1">
            <!-- Имя пользователя -->
            <TextBlock Text="Логин" FontSize="13" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,5"/>
            <TextBox x:Name="UsernameTextBox"
                     FontSize="14" Padding="10,8" Margin="0,0,0,15"
                     Background="{DynamicResource ThemeInputBg}"
                     Foreground="{DynamicResource ThemeTextPrimary}"
                     BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1"/>
            
            <!-- Пароль -->
            <TextBlock Text="Пароль" FontSize="13" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox"
                         FontSize="14" Padding="10,8" Margin="0,0,0,35"
                         Background="{DynamicResource ThemeInputBg}"
                         Foreground="{DynamicResource ThemeTextPrimary}"
                         BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1"
                         KeyDown="PasswordBox_KeyDown"
                         Height="35"/>

            <!-- Сообщение об ошибке -->
            <TextBlock x:Name="ErrorTextBlock" FontSize="12" Foreground="{DynamicResource ThemeError}" 
                       TextWrapping="Wrap" Margin="0,0,0,10"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Кнопки входа -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
            <Button Content="Войти" x:Name="LoginButton" Click="LoginButton_Click" 
                    Background="{DynamicResource ThemeInfo}" Foreground="White"
                    Padding="20,8" Margin="0,0,10,0" Width="80"/>
            <Button Content="Выход" x:Name="CancelButton" Click="CancelButton_Click" 
                    Background="{DynamicResource ThemeTextSecondary}" Foreground="White"
                    Padding="20,8" Width="80"/>
        </StackPanel>

        <!-- Статус соединения и настройки -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center">
            <!-- Индикатор соединения (показывается всегда) -->
            <Border x:Name="ConnectionStatusBorder" Background="{DynamicResource ThemeWidgetSuccessBg}" CornerRadius="4" 
                    Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="●" FontSize="16" Foreground="{DynamicResource ThemeSuccess}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Подключено к серверу" FontSize="12" Foreground="{DynamicResource ThemeSuccess}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Блок без соединения -->
            <StackPanel x:Name="NoConnectionPanel" Visibility="Collapsed">
                <Border Background="{DynamicResource ThemeWidgetWarningBg}" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⚠" FontSize="16" Foreground="{DynamicResource ThemeWarning}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Нет соединения с сервером" FontSize="12" Foreground="{DynamicResource ThemeWarning}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button Content="Настройки подключения" 
                        Command="{Binding OpenSettingsCommand}"
                        Background="{DynamicResource ThemeWarning}" Foreground="White"
                        Padding="15,6" Width="180" HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
