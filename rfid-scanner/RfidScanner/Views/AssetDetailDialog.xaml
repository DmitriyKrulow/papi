<Window x:Class="RfidScanner.Views.AssetDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали актива" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#E3F2FD" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Детали актива" FontSize="18" FontWeight="Bold" Foreground="#1565C0"/>
                <TextBlock x:Name="RfidTagText" Text="RFID: —" FontSize="13" Foreground="#424242" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Информация -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Статус -->
                <Border Background="White" BorderThickness="1" BorderBrush="#E0E0E0" 
                       CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Статус:" FontWeight="Bold" Foreground="#616161"/>
                        <TextBlock Grid.Column="1" x:Name="StatusText" Text="—" FontSize="14"/>
                    </Grid>
                </Border>

                <!-- Название -->
                <Border Background="White" BorderThickness="1" BorderBrush="#E0E0E0" 
                       CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Название:" FontWeight="Bold" Foreground="#616161"/>
                        <TextBlock Grid.Column="1" x:Name="AssetNameText" Text="—" FontSize="14"/>
                    </Grid>
                </Border>

                <!-- Инв. номер -->
                <Border Background="White" BorderThickness="1" BorderBrush="#E0E0E0" 
                       CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Инв. номер:" FontWeight="Bold" Foreground="#616161"/>
                        <TextBlock Grid.Column="1" x:Name="InventoryNumberText" Text="—" FontSize="14"/>
                    </Grid>
                </Border>

                <!-- Время сканирования -->
                <Border Background="White" BorderThickness="1" BorderBrush="#E0E0E0" 
                       CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Время:" FontWeight="Bold" Foreground="#616161"/>
                        <TextBlock Grid.Column="1" x:Name="ScannedAtText" Text="—" FontSize="14"/>
                    </Grid>
                </Border>

                <!-- Примечание -->
                <Border Background="White" BorderThickness="1" BorderBrush="#E0E0E0" 
                       CornerRadius="6" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Примечание:" FontWeight="Bold" Foreground="#616161" VerticalAlignment="Top"/>
                        <TextBox Grid.Column="1" x:Name="NoteTextBox" Text="" 
                                TextWrapping="Wrap" AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                FontSize="14" Padding="5"
                                Background="#FAFAFA"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить" Click="SaveButton_Click" 
                   Background="#4CAF50" Foreground="White" Padding="20,8" Margin="0,0,10,0"
                   FontSize="13"/>
            <Button Content="Закрыть" Click="CloseButton_Click" 
                   Background="#E0E0E0" Foreground="#424242" Padding="20,8"
                   FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
