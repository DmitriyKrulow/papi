<UserControl x:Class="RfidScanner.Views.RoomSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RfidScanner.ViewModels"
             Background="#F5F5F5">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== ЗАГОЛОВОК С ПРИВЕТСТВИЕМ ===== -->
        <Border Grid.Row="0" Background="White" Padding="30" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
            <StackPanel>
                <TextBlock Text="📋 PAPI RFID Scanner" 
                          FontSize="28" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,5"/>
                <TextBlock Text="Выберите помещение или зону для начала инвентаризации" 
                          FontSize="16" Foreground="#616161" Margin="0,0,0,15"/>
                
                <!-- ===== ПОШАГОВАЯ ИНСТРУКЦИЯ ===== -->
                <Border Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="2" 
                       CornerRadius="10" Padding="20" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🚀 Быстрый старт:" 
                                  FontWeight="Bold" Foreground="#2E7D32" FontSize="16" Margin="0,0,0,12"/>
                        <TextBlock FontSize="15" Foreground="#33691E" TextWrapping="Wrap">
                            <Run Text="1. "/>
                            <Bold>Выберите помещение</Bold> из списка ниже<LineBreak/>
                            <Run Text="2. "/>
                            <Bold>Нажмите «Начать инвентаризацию»</Bold><LineBreak/>
                            <Run Text="3. "/>
                            <Bold>Поднесите RFID-сканер к меткам</Bold> на расстоянии 1-3 см<LineBreak/>
                            <Run Text="4. "/>
                            <Bold>Следуйте подсказкам</Bold> — зелёный = найден, оранжевый = лишний<LineBreak/>
                            <Run Text="5. "/>
                            <Bold>Нажмите «Завершить»</Bold> когда пройдёте все метки
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ===== ПОДСКАЗКА ПО СКАНИРОВАНИЮ ===== -->
                <Border Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1" 
                       CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="💡 Советы для точного сканирования:" 
                                  FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,8"/>
                        <TextBlock FontSize="13" Foreground="#424242" TextWrapping="Wrap">
                            <Run Text="• "/>
                            Держите сканер перпендикулярно метке<LineBreak/>
                            <Run Text="• "/>
                            Избегайте металлических поверхностей рядом<LineBreak/>
                            <Run Text="• "/>
                            Один тег за раз — не наводите на группу меток<LineBreak/>
                            <Run Text="• "/>
                            Ожидайте звуковой сигнал перед следующим сканированием
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== ПОИСК И СПИСОК ПОМЕЩЕНИЙ ===== -->
        <Border Grid.Row="1" Background="White" Margin="30" CornerRadius="10" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Поиск -->
                <TextBox Grid.Row="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="16" Padding="12,10" Margin="0,0,0,20"
                         Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1"
                         VerticalContentAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Список помещений -->
                <ListView Grid.Row="1" ItemsSource="{Binding Rooms}" 
                          SelectedItem="{Binding SelectedRoom}"
                          BorderThickness="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="18" Margin="0,5" CornerRadius="8"
                                   Background="#FAFAFA" BorderThickness="1" BorderBrush="#E0E0E0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" 
                                              Foreground="#212121"/>
                                    <TextBlock FontSize="14" Foreground="#757575" Margin="0,4,0,0">
                                        <Run Text="🏢 "/>
                                        <Run Text="{Binding Building, FallbackValue='Не указано'}"/>
                                        <Run Text=" | "/>
                                        <Run Text="📐 "/>
                                        <Run Text="{Binding Floor, FallbackValue='Не указано'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Пустой список -->
                <TextBlock Text="Нет доступных помещений. Проверьте подключение к серверу." 
                          FontSize="14" Foreground="#BDBDBD" HorizontalAlignment="Center" 
                          VerticalAlignment="Center" Margin="20"
                          Visibility="{Binding Rooms.Count, Converter={StaticResource CollectionCountToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- ===== КНОПКА СТАРТА ===== -->
        <Border Grid.Row="2" Background="White" Padding="30" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" 
                          FontSize="15" Foreground="#757575" VerticalAlignment="Center"
                          Margin="0,0,20,0"/>

                <Button Grid.Column="1" Content="▶ Начать инвентаризацию" 
                        Click="StartButton_Click"
                        Background="#4CAF50" Foreground="White"
                        FontSize="20" Padding="35,15"
                        Width="300" Height="65"
                        IsEnabled="{Binding !IsLoading}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="#4CAF50"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="20"/>
                            <Setter Property="Padding" Value="35,15"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#BDBDBD"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Индикатор загрузки -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="White" Opacity="0.85" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="200" Height="20" IsIndeterminate="True"
                            Background="#E0E0E0" Foreground="#2196F3"/>
                <TextBlock Text="Загрузка..." FontSize="16" Foreground="#616161" Margin="0,10,0,0"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
