<UserControl x:Class="RfidScanner.Views.RoomSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== ЗАГОЛОВОК ===== -->
        <Border Grid.Row="0" Background="White" Padding="20,12" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
            <Grid>
                <TextBlock Text="📋 PAPI RFID Scanner" 
                          FontSize="20" FontWeight="Bold" Foreground="#1976D2"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                          Text="Выберите помещение для инвентаризации" 
                          FontSize="13" Foreground="#757575"/>
            </Grid>
        </Border>

        <!-- ===== ПОМЕЩЕНИЯ ===== -->
        <Border Grid.Row="1" Background="White" Margin="20,10,20,10" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Поиск -->
                <TextBox Grid.Row="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="14" Padding="10,8" Margin="0,0,0,10"
                         Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1"
                         VerticalContentAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Список -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListView ItemsSource="{Binding Rooms}" 
                              SelectedItem="{Binding SelectedRoom}"
                              BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" Margin="0,2" CornerRadius="6"
                                       Background="#FAFAFA" BorderThickness="1" BorderBrush="#E0E0E0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" 
                                                  Foreground="#212121"/>
                                        <TextBlock FontSize="12" Foreground="#757575" Margin="0,2,0,0">
                                            <Run Text="🏢 "/>
                                            <Run Text="{Binding Building, FallbackValue='—'}"/>
                                            <Run Text=" | "/>
                                            <Run Text="📐 "/>
                                            <Run Text="{Binding Floor, FallbackValue='—'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>

                <!-- Пустой список -->
                <TextBlock Text="Нет помещений. Проверьте подключение к серверу." 
                          FontSize="13" Foreground="#BDBDBD" HorizontalAlignment="Center" 
                          VerticalAlignment="Center" Margin="10"
                          Visibility="{Binding Rooms.Count, Converter={StaticResource CollectionCountToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- ===== НИЖНЯЯ ПАНЕЛЬ ===== -->
        <Border Grid.Row="2" Background="#FAFAFA" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" 
                          FontSize="12" Foreground="#757575" 
                          Padding="20,8,20,4"
                          TextTrimming="CharacterEllipsis"/>

                <Button Grid.Row="1" Content="▶ Начать инвентаризацию" 
                        Click="StartButton_Click"
                        Background="#4CAF50" Foreground="White"
                        FontSize="16" Padding="40,12"
                        Width="280" Height="48"
                        IsEnabled="{Binding !IsLoading}"
                        Margin="0,0,20,12" HorizontalAlignment="Right">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Background" Value="#4CAF50"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#BDBDBD"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Загрузка -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="White" Opacity="0.85" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="160" Height="16" IsIndeterminate="True"
                            Background="#E0E0E0" Foreground="#2196F3"/>
                <TextBlock Text="Загрузка..." FontSize="14" Foreground="#616161" Margin="0,8,0,0"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
