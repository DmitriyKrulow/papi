<UserControl x:Class="RfidScanner.Views.AuditView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="clr-namespace:RfidScanner.ViewModels"
              xmlns:conv="clr-namespace:RfidScanner.Converters"
              Background="{DynamicResource ThemeBg}">
    
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <!-- Стили заголовков и строк таблицы (доступны из этого UserControl) -->
        <Style x:Key="ModernColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernRow" TargetType="DataGridRow">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeWidgetInfoBg}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AuditCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопка обновления -->
        <Border Grid.Row="0" Background="{DynamicResource ThemeCardBg}" 
                Padding="24,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ThemeBorderBrush}"
                Margin="20,20,20,0" CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📜 История действий" FontSize="18" FontWeight="Bold" 
                                  Foreground="{DynamicResource ThemeTextPrimary}"/>
                        <TextBlock Text="Журнал операций и аудит" FontSize="12" 
                                  Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <Border Grid.Column="1" Background="{DynamicResource ThemeAccent}" 
                            CornerRadius="8" Padding="16,8">
                        <Button Content="🔄 Обновить" 
                                Command="{Binding RefreshCommand}"
                                Foreground="White" 
                                BorderThickness="0"
                                FontSize="13"
                                Background="Transparent"/>
                    </Border>
                </Grid>
        </Border>

        <!-- Таблица истории -->
        <Border Grid.Row="1" Style="{StaticResource AuditCard}">
            <DataGrid ItemsSource="{Binding History}" 
                     AutoGenerateColumns="False" IsReadOnly="True"
                     FontSize="13" GridLinesVisibility="Horizontal"
                     HeadersVisibility="Column" SelectionMode="Single"
                     BorderThickness="0"
                     Background="{DynamicResource ThemeCardBg}"
                     Foreground="{DynamicResource ThemeTextPrimary}"
                     RowBackground="{DynamicResource ThemeCardBg}"
                     AlternatingRowBackground="{DynamicResource ThemeSurfaceBg}"
                     ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                     RowStyle="{StaticResource ModernRow}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Пользователь" Binding="{Binding Username}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccent}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Помещение" Binding="{Binding RoomName}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Детали" Binding="{Binding Details}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
