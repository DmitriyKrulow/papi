<UserControl x:Class="RfidScanner.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">
    
    <Grid Margin="15,12,15,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Список проверяемого имущества получает основной объём -->
            <RowDefinition Height="2*" MinHeight="150"/>
            <RowDefinition Height="*" MinHeight="70"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="White" Padding="14,8" CornerRadius="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="📡 Режим сканирования" FontSize="17" FontWeight="Bold" Foreground="#1976D2"/>
                    <TextBlock x:Name="RoomNameText" Text="Помещение: ..." FontSize="12" Foreground="#757575" Margin="0,2,0,0"/>
                </StackPanel>
                
                <Border Grid.Column="1" Background="#E8F5E9" Padding="8,4" CornerRadius="4" VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressText" Text="0 / 0" FontSize="13" FontWeight="Bold" Foreground="#2E7D32"/>
                </Border>
            </Grid>
        </Border>

        <!-- Статус последнего сканирования -->
        <Border Grid.Row="1" Background="White" Padding="14,6" CornerRadius="8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Последняя метка:" FontSize="11" Foreground="#9E9E9E"/>
                <TextBlock x:Name="LastTagText" Text="—" FontSize="16" FontWeight="Bold" Foreground="#2196F3" Margin="0,1,0,0"/>
                <TextBlock x:Name="StatusText" Text="Ожидание сканирования..." FontSize="12" Foreground="#757575" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Сводка -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#E8F5E9" Padding="10,6" CornerRadius="8" Margin="0,0,4,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="✅ Найдено" FontSize="11" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="MatchedCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#FFF3E0" Padding="10,6" CornerRadius="8" Margin="4,0,4,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⚠️ Лишние" FontSize="11" Foreground="#FF9800" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ExtraCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#FFEBEE" Padding="10,6" CornerRadius="8" Margin="4,0,4,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="❌ Пропущены" FontSize="11" Foreground="#F44336" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="MissingCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#C62828" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="#E3F2FD" Padding="10,6" CornerRadius="8" Margin="4,0,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📊 Всего" FontSize="11" Foreground="#2196F3" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotalCountText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Список активов помещения -->
        <Border Grid.Row="3" Background="White" Padding="15" CornerRadius="8" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="📋 Проверяемое имущество" FontSize="14" FontWeight="Bold" Foreground="#424242"/>
                    <TextBlock Text="(всего: " FontSize="11" Foreground="#9E9E9E" Margin="10,0,0,0"/>
                    <TextBlock x:Name="TotalAssetsText" Text="0" FontSize="11" Foreground="#1976D2" FontWeight="Bold"/>
                    <TextBlock Text=")" FontSize="11" Foreground="#9E9E9E"/>
                </StackPanel>

                <!-- Пустое состояние -->
                <TextBlock x:Name="EmptyAssetsText" Grid.Row="1" FontSize="12" Foreground="#9E9E9E" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10"
                           Text="Список имущества пуст или ещё не загружен" Visibility="Collapsed"/>

                <ListView Grid.Row="1" x:Name="RoomAssetsList" BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Stretch">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F5F5F5" Padding="10,6" CornerRadius="4" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding AssetName, Mode=OneWay}" FontSize="12" FontWeight="Bold" Foreground="#212121"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="10" Foreground="#757575" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="Инв: "/>
                                            <Run Text="{Binding InventoryNumber, Mode=OneWay}"/>
                                            <Run Text=" | "/>
                                            <Run Text="Метка: "/>
                                            <Run Text="{Binding RfidTag, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    
                                    <Border Grid.Column="1" Background="{Binding StatusColor}" Padding="8,3" CornerRadius="4"
                                            VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Результаты сканирования -->
        <Border Grid.Row="4" Background="White" Padding="15" CornerRadius="8" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Результаты сканирования" FontSize="14" FontWeight="Bold" Foreground="#424242"/>
                    <TextBlock Text="(последние 50)" FontSize="11" Foreground="#9E9E9E" Margin="10,0,0,0"/>
                </StackPanel>
                <ListView Grid.Row="1" x:Name="ResultsList" BorderThickness="0" Background="Transparent"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding AssetName, Mode=OneWay}" FontSize="12" FontWeight="Bold"/>
                                <TextBlock FontSize="10" Foreground="#757575">
                                    <Run Text="Инв: "/>
                                    <Run Text="{Binding InventoryNumber, Mode=OneWay}"/>
                                    <Run Text=" | "/>
                                    <Run Text="Метка: "/>
                                    <Run Text="{Binding RfidTag, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Кнопки управления -->
        <Border Grid.Row="5" Background="White" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="⏭ Пропустить непроверенные" x:Name="SkipUncheckedButton" Click="SkipUncheckedButton_Click" 
                        Background="#9C27B0" Foreground="White" Padding="10,6" Margin="0,0,8,0" FontSize="12"
                        ToolTip="Пометить все непроверенные активы как отсутствующие"/>
                <Button Content="↩ Выйти" Click="ExitButton_Click" 
                        Background="#607D8B" Foreground="White" Padding="10,6" Margin="0,0,8,0" Width="95" FontSize="13"/>
                <Button Content="⏸ Пауза" x:Name="PauseButton" Click="PauseButton_Click" 
                        Background="#FF9800" Foreground="White" Padding="10,6" Margin="0,0,8,0" Width="115" FontSize="13"/>
                <Button Content="🔄 Сбросить" Click="ResetButton_Click" 
                        Background="#F44336" Foreground="White" Padding="10,6" Margin="0,0,8,0" Width="115" FontSize="13"/>
                <Button Content="✅ Завершить" Click="FinishButton_Click" 
                        Background="#4CAF50" Foreground="White" Padding="10,6" Width="140" FontWeight="Bold" FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
