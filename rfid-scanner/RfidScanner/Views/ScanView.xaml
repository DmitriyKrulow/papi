<UserControl x:Class="RfidScanner.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="White" Padding="20" CornerRadius="8" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📡 Режим сканирования" FontSize="22" FontWeight="Bold" Foreground="#1976D2"/>
                    <TextBlock x:Name="RoomNameText" Text="Помещение: ..." FontSize="14" Foreground="#757575" Margin="0,5,0,0"/>
                </StackPanel>
                
                <Border Grid.Column="1" Background="#E8F5E9" Padding="10,5" CornerRadius="4">
                    <TextBlock x:Name="ProgressText" Text="0 / 0" FontSize="14" FontWeight="Bold" Foreground="#2E7D32"/>
                </Border>
            </Grid>
        </Border>

        <!-- Статус последнего сканирования -->
        <Border Grid.Row="1" Background="White" Padding="20" CornerRadius="8" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Последняя метка:" FontSize="12" Foreground="#9E9E9E"/>
                    <TextBlock x:Name="LastTagText" Text="—" FontSize="20" FontWeight="Bold" Foreground="#2196F3" Margin="0,5,0,0"/>
                    <TextBlock x:Name="StatusText" Text="Ожидание сканирования..." FontSize="14" Foreground="#757575" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Сводка -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#E8F5E9" Padding="15" CornerRadius="8" Margin="0,0,5,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="✅ Найдено" FontSize="12" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="MatchedCountText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#FFF3E0" Padding="15" CornerRadius="8" Margin="5,0,5,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⚠️ Лишние" FontSize="12" Foreground="#FF9800" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ExtraCountText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#FFEBEE" Padding="15" CornerRadius="8" Margin="5,0,5,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="❌ Пропущены" FontSize="12" Foreground="#F44336" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="MissingCountText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#C62828" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="#E3F2FD" Padding="15" CornerRadius="8" Margin="5,0,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📊 Всего" FontSize="12" Foreground="#2196F3" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotalCountText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Результаты сканирования -->
        <Border Grid.Row="3" Background="White" Padding="15" CornerRadius="8" Margin="0,0,0,15" Height="180">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Результаты сканирования" FontSize="14" FontWeight="Bold" Foreground="#424242"/>
                    <TextBlock Text="(последние 50)" FontSize="11" Foreground="#9E9E9E" Margin="10,0,0,0"/>
                </StackPanel>
                <ListView Grid.Row="1" x:Name="ResultsList" BorderThickness="0" Background="Transparent"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding AssetName}" FontSize="12" FontWeight="Bold"/>
                                <TextBlock FontSize="10" Foreground="#757575">
                                    <Run Text="Инв: "/>
                                    <Run Text="{Binding InventoryNumber}"/>
                                    <Run Text=" | "/>
                                    <Run Text="Метка: "/>
                                    <Run Text="{Binding RfidTag}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Кнопки управления -->
        <Border Grid.Row="4" Background="White" Padding="15" CornerRadius="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="↩ Выйти" Click="ExitButton_Click" 
                        Background="#607D8B" Foreground="White" Padding="15,8" Margin="0,0,10,0" Width="100"/>
                <Button Content="⏸ Пауза" x:Name="PauseButton" Click="PauseButton_Click" 
                        Background="#FF9800" Foreground="White" Padding="15,8" Margin="0,0,10,0" Width="120"/>
                <Button Content="🔄 Сбросить" Click="ResetButton_Click" 
                        Background="#F44336" Foreground="White" Padding="15,8" Margin="0,0,10,0" Width="120"/>
                <Button Content="✅ Завершить" Click="FinishButton_Click" 
                        Background="#4CAF50" Foreground="White" Padding="15,8" Width="150" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
