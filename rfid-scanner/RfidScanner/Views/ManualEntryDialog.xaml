<Window x:Class="RfidScanner.Views.ManualEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ручной ввод актива" Height="450" Width="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#FFF3E0" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="✏️ Ручной ввод актива" FontSize="18" FontWeight="Bold" Foreground="#E65100"/>
                <TextBlock Text="Метка потеряна или актив не был промаркирован. Заполните данные вручную." 
                          FontSize="13" Foreground="#BF360C" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Форма -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Инв. номер (обязательный) -->
                <TextBlock Text="Инвентарный номер *" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,5"/>
                <TextBox x:Name="InventoryNumberBox" FontSize="14" Padding="10" Margin="0,0,0,15"
                        Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1"
                        VerticalContentAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Название (обязательное) -->
                <TextBlock Text="Название актива *" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,5"/>
                <TextBox x:Name="AssetNameBox" FontSize="14" Padding="10" Margin="0,0,0,15"
                        Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1"
                        VerticalContentAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Тип актива -->
                <TextBlock Text="Тип актива" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,5"/>
                <ComboBox x:Name="AssetTypeBox" FontSize="14" Padding="10" Margin="0,0,0,15"
                         Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1">
                    <ComboBoxItem Content="Оборудование"/>
                    <ComboBoxItem Content="Мебель"/>
                    <ComboBoxItem Content="Техника"/>
                    <ComboBoxItem Content="Инструмент"/>
                    <ComboBoxItem Content="Другое"/>
                </ComboBox>

                <!-- Серийный номер -->
                <TextBlock Text="Серийный номер" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,5"/>
                <TextBox x:Name="SerialNumberBox" FontSize="14" Padding="10" Margin="0,0,0,15"
                        Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1"
                        VerticalContentAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Ответственный -->
                <TextBlock Text="Ответственный" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,5"/>
                <TextBox x:Name="ResponsibleBox" FontSize="14" Padding="10" Margin="0,0,0,15"
                        Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1"
                        VerticalContentAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Примечание -->
                <TextBlock Text="Примечание" FontWeight="Bold" Foreground="#424242" Margin="0,0,0,5"/>
                <TextBox x:Name="NoteBox" TextWrapping="Wrap" AcceptsReturn="True"
                        FontSize="14" Padding="10" Height="60"
                        Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1"
                        VerticalScrollBarVisibility="Auto">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Добавить" Click="AddButton_Click" 
                   Background="#FF9800" Foreground="White" Padding="20,8" Margin="0,0,10,0"
                   FontSize="13"/>
            <Button Content="Отмена" Click="CancelButton_Click" 
                   Background="#E0E0E0" Foreground="#424242" Padding="20,8"
                   FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
