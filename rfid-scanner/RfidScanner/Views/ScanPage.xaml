<UserControl x:Class="RfidScanner.Views.ScanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Текущий тег -->
        <Border Grid.Row="0" Background="#E3F2FD" BorderBrush="#2196F3" 
                BorderThickness="2" CornerRadius="8" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Отсканированный тег:" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding LastScannedTag, FallbackValue='(ожидание сканирования...)'}" 
                          FontSize="24" FontWeight="Bold" Foreground="#1565C0"/>
            </StackPanel>
        </Border>

        <!-- Результат сканирования -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CCCCCC" 
                BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Последние сканирования:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding RecentScans, FallbackValue={x:Null}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="0,5" CornerRadius="4"
                                        Background="{Binding Success, Converter={StaticResource BooleanToBrushConverter}, FallbackValue=White}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RfidTag, FallbackValue=''}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Message, FallbackValue=''}" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Ручной ввод -->
        <Border Grid.Row="2" Background="#F5F5F5" BorderBrush="#DDDDDD" 
                BorderThickness="1" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Grid>
                    <TextBlock Text="Введите RFID-тег вручную..." Foreground="Gray" 
                              Margin="5,0" VerticalAlignment="Center" IsHitTestVisible="False"
                              x:Name="ManualPlaceholder"/>
                    <TextBox x:Name="ManualInput" KeyDown="ManualInput_KeyDown"
                            TextChanged="ManualInput_TextChanged"/>
                </Grid>
                <Button Grid.Column="1" Content="Отправить" Margin="10,0,0,0"
                       Click="SendButton_Click" Padding="20,5"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
