<UserControl x:Class="RfidScanner.Views.ScanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RfidScanner.ViewModels"
             xmlns:conv="clr-namespace:RfidScanner.Converters"
             Background="#F5F5F5">

    <UserControl.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <conv:StatusToIconConverter x:Key="StatusToIconConverter"/>
        <conv:StatusToTextConverter x:Key="StatusToTextConverter"/>
        
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        
        <Style x:Key="ResultItem" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== СВODКА (Summary) ===== -->
        <Border Grid.Row="0" Background="White" Padding="20" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
            <StackPanel>
                <!-- Заголовок с помещением -->
                <TextBlock Text="{Binding SessionRoomName, FallbackValue='Помещение не выбрано'}" 
                          FontSize="20" FontWeight="Bold" Foreground="#212121" Margin="0,0,0,5"/>
                
                <!-- Сводка -->
                <Grid Margin="0,5,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Найдено -->
                    <Border Grid.Column="0" Style="{StaticResource SummaryCard}" Background="#E8F5E9">
                        <StackPanel>
                            <TextBlock Text="✅ Найдено" FontSize="12" Foreground="#2E7D32"/>
                            <TextBlock Text="{Binding MatchedCount}" FontSize="24" FontWeight="Bold" Foreground="#1B5E20"/>
                        </StackPanel>
                    </Border>

                    <!-- Лишние -->
                    <Border Grid.Column="2" Style="{StaticResource SummaryCard}" Background="{Binding ExtraCount, Converter={StaticResource CountToBackgroundConverter}}">
                        <StackPanel>
                            <TextBlock Text="⚠️ Лишние" FontSize="12" Foreground="#E65100"/>
                            <TextBlock Text="{Binding ExtraCount}" FontSize="24" FontWeight="Bold" Foreground="#E65100"/>
                        </StackPanel>
                    </Border>

                    <!-- Пропущены -->
                    <Border Grid.Column="4" Style="{StaticResource SummaryCard}" Background="#FFF3E0">
                        <StackPanel>
                            <TextBlock Text="❌ Пропущены" FontSize="12" Foreground="#BF360C"/>
                            <TextBlock Text="{Binding MissingCount}" FontSize="24" FontWeight="Bold" Foreground="#BF360C"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Прогресс-бар -->
                <ProgressBar Height="8" Value="{Binding ProgressPercent}" Maximum="100" 
                            Background="#E0E0E0" Foreground="#4CAF50" Margin="0,0,0,5"/>
                
                <!-- Подсказка при сканировании -->
                <TextBlock Text="{Binding HintText, FallbackValue='Сканируйте RFID-метки сканером...'}" 
                          FontSize="13" Foreground="#757575" TextWrapping="Wrap" Margin="0,0,0,5"/>
                
                <!-- Кнопка-подсказка -->
                <TextBlock FontWeight="Bold" Foreground="#1976D2" Cursor="Hand" Margin="0,0,0,5">
                    <TextBlock.Inlines>
                        <Run Text="💡"/>
                        <Run Text=" Как правильно сканировать: поднесите сканер на 1-3 см к метке, подождите сигнал"/>
                    </TextBlock.Inlines>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ===== ПОИСК И ФИЛЬТРЫ ===== -->
        <Border Grid.Row="1" Background="White" Padding="20" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск -->
                <TextBox Grid.Column="0" 
                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                        FontSize="14" Padding="10,8"
                        Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1"
                        VerticalContentAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Фильтр: Все -->
                <RadioButton Grid.Column="1" Content="Все" 
                            IsChecked="{Binding FilterAll, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="10,0,5,0" Foreground="#424242" FontSize="13"
                            GroupName="FilterGroup"/>

                <!-- Фильтр: Найдено -->
                <RadioButton Grid.Column="2" Content="✅ Найдено" 
                            Margin="5,0,5,0" Foreground="#2E7D32" FontSize="13"
                            GroupName="FilterGroup"
                            IsChecked="{Binding FilterFound}"/>

                <!-- Фильтр: Лишние -->
                <RadioButton Grid.Column="3" Content="⚠️ Лишние" 
                            Margin="5,0,5,0" Foreground="#E65100" FontSize="13"
                            GroupName="FilterGroup"
                            IsChecked="{Binding FilterExtra}"/>

                <!-- Фильтр: Пропущены -->
                <RadioButton Grid.Column="4" Content="❌ Пропущены" 
                            Margin="5,0,5,0" Foreground="#BF360C" FontSize="13"
                            GroupName="FilterGroup"
                            IsChecked="{Binding FilterMissing}"/>
            </Grid>
        </Border>

        <!-- ===== СПИСОК РЕЗУЛЬТАТОВ ===== -->
        <Border Grid.Row="2" Background="White" Margin="20" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Список результатов -->
                <ListView Grid.Row="0" ItemsSource="{Binding FilteredResults}"
                         SelectedItem="{Binding SelectedResult}"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseDoubleClick="ResultListView_MouseDoubleClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ResultItem}"
                                   BorderBrush="{Binding Status, Converter={StaticResource StatusToBrushConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка статуса -->
                                    <TextBlock Grid.Column="0" FontSize="20" Margin="0,0,10,0"
                                              Text="{Binding Status, Converter={StaticResource StatusToIconConverter}}"
                                              VerticalAlignment="Center"/>

                                    <!-- Информация об активе -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding AssetName, FallbackValue='Неизвестный актив'}" 
                                                  FontSize="14" FontWeight="Bold" Foreground="#212121"/>
                                        <TextBlock FontSize="12" Foreground="#757575" Margin="0,2,0,0">
                                            <Run Text="📋 "/>
                                            <Run Text="{Binding InventoryNumber, FallbackValue='—'}"/>
                                            <Run Text=" | "/>
                                            <Run Text="📍 "/>
                                            <Run Text="{Binding RfidTag, FallbackValue='—'}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Статус текстом -->
                                    <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                                              Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                              Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Пустое состояние -->
                <TextBlock Text="Сканируйте RFID-метки..." FontSize="16" Foreground="#BDBDBD" 
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{Binding HasResults, Converter={StaticResource InverseBooleanConverter}}"/>
            </Grid>
        </Border>

        <!-- ===== КНОПКИ УПРАВЛЕНИЯ ===== -->
        <Border Grid.Row="3" Background="White" Padding="20" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Основная строка кнопок -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Статус синхронизации -->
                    <TextBlock Grid.Column="0" Text="{Binding SyncStatus, FallbackValue='Готово'}" 
                              FontSize="13" Foreground="#757575" VerticalAlignment="Center"/>

                    <!-- Ручной ввод -->
                    <Button Grid.Column="1" Content="✏️ Ввести вручную" 
                           Command="{Binding ManualEntryCommand}"
                           Background="#9C27B0" Foreground="White" Padding="15,8" Margin="10,0,5,0"
                           FontSize="13"/>

                    <!-- Пауза -->
                    <Button Grid.Column="2" Content="⏸ Пауза" Click="PauseButton_Click"
                           Background="#FF9800" Foreground="White" Padding="15,8" Margin="5,0,5,0"
                           FontSize="13" x:Name="PauseBtn"/>

                    <!-- Возобновить -->
                    <Button Grid.Column="3" Content="▶ Продолжить" Click="ResumeButton_Click"
                           Background="#4CAF50" Foreground="White" Padding="15,8" Margin="5,0,5,0"
                           FontSize="13" x:Name="ResumeBtn" Visibility="Collapsed"/>

                    <!-- Пропустить -->
                    <Button Grid.Column="4" Content="⏭ Пропустить" Click="SkipButton_Click"
                           Background="#9E9E9E" Foreground="White" Padding="15,8" Margin="5,0,5,0"
                           FontSize="13"/>

                    <!-- Завершить -->
                    <Button Grid.Column="5" Content="✅ Завершить" Click="FinishButton_Click"
                           Background="#2196F3" Foreground="White" Padding="20,8" Margin="5,0,0,0"
                           FontSize="14" FontWeight="Bold"/>
                </Grid>

                <!-- Дополнительная строка: экспорт и интеграция -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="📄 Экспорт отчёта" 
                           Command="{Binding ExportReportCommand}"
                           Background="#607D8B" Foreground="White" Padding="12,6" Margin="0,0,5,0"
                           FontSize="12" Visibility="{Binding CanExportReports, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="🔗 Синхронизировать с 1С" 
                           Command="{Binding SyncWith1CCommand}"
                           Background="#3F51B5" Foreground="White" Padding="12,6"
                           FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
