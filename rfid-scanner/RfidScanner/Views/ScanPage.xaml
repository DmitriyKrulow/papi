<UserControl x:Class="RfidScanner.Views.ScanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RfidScanner.ViewModels"
             xmlns:conv="clr-namespace:RfidScanner.Converters"
             Background="{DynamicResource ThemeBg}">

    <UserControl.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        <conv:StatusToIconConverter x:Key="StatusToIconConverter"/>
        <conv:StatusToTextConverter x:Key="StatusToTextConverter"/>
        <conv:CountToBackgroundConverter x:Key="CountToBackgroundConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        
        <!-- Анимация пульсации при сканировании -->
        <Storyboard x:Key="ScanPulseStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0" To="0.3" Duration="0:0:0.1"
                           AutoReverse="True" RepeatBehavior="3x"/>
        </Storyboard>

        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.05"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="ResultItem" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== СВОДКА (Summary) ===== -->
        <Border Grid.Row="0" Padding="20" BorderThickness="0,0,0,1"
                Background="{DynamicResource ThemeCardBg}" 
                BorderBrush="{DynamicResource ThemeBorderBrush}">
            <Grid>
                <!-- Пульсация при сканировании -->
                <Border x:Name="ScanPulseBorder" Background="{DynamicResource ThemeSuccess}" 
                        Opacity="0" CornerRadius="8" Margin="-20"/>
                
                <StackPanel>
                    <!-- Заголовок с помещением -->
                    <TextBlock Text="{Binding SessionRoomName, FallbackValue='Помещение не выбрано'}" 
                              FontSize="20" FontWeight="Bold" 
                              Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,5"/>
                    
                    <!-- Сводка -->
                    <Grid Margin="0,5,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Найдено -->
                    <Border Grid.Column="0" Style="{StaticResource SummaryCard}" 
                            Background="{DynamicResource ThemeWidgetSuccessBg}">
                        <StackPanel>
                            <TextBlock Text="✅ Найдено" FontSize="12" 
                                      Foreground="{DynamicResource ThemeSuccess}"/>
                            <TextBlock Text="{Binding MatchedCount}" FontSize="24" FontWeight="Bold" 
                                      Foreground="{DynamicResource ThemeSuccess}"/>
                        </StackPanel>
                    </Border>

                    <!-- Лишние -->
                    <Border Grid.Column="2" Style="{StaticResource SummaryCard}" 
                            Background="{Binding ExtraCount, Converter={StaticResource CountToBackgroundConverter}}">
                        <StackPanel>
                            <TextBlock Text="⚠️ Лишние" FontSize="12" 
                                      Foreground="{DynamicResource ThemeWarning}"/>
                            <TextBlock Text="{Binding ExtraCount}" FontSize="24" FontWeight="Bold" 
                                      Foreground="{DynamicResource ThemeWarning}"/>
                        </StackPanel>
                    </Border>

                    <!-- Пропущены -->
                    <Border Grid.Column="4" Style="{StaticResource SummaryCard}" 
                            Background="{DynamicResource ThemeWidgetErrorBg}">
                        <StackPanel>
                            <TextBlock Text="❌ Пропущены" FontSize="12" 
                                      Foreground="{DynamicResource ThemeError}"/>
                            <TextBlock Text="{Binding MissingCount}" FontSize="24" FontWeight="Bold" 
                                      Foreground="{DynamicResource ThemeError}"/>
                        </StackPanel>
                    </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== ПОИСК И ФИЛЬТРЫ ===== -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeCardBg}" 
                Padding="20" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ThemeBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск -->
                <Border Grid.Column="0" Background="{DynamicResource ThemeInputBg}" 
                        CornerRadius="6" BorderBrush="{DynamicResource ThemeInputBorder}" 
                        BorderThickness="1">
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="14" Padding="10,8"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"/>
                </Border>

                <!-- Фильтр: Все -->
                <RadioButton Grid.Column="1" Content="Все" 
                            IsChecked="{Binding FilterAll, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="10,0,5,0" 
                            Foreground="{DynamicResource ThemeTextPrimary}" FontSize="13"
                            GroupName="FilterGroup"/>

                <!-- Фильтр: Найдено -->
                <RadioButton Grid.Column="2" Content="✅ Найдено" 
                            Margin="5,0,5,0" 
                            Foreground="{DynamicResource ThemeSuccess}" FontSize="13"
                            GroupName="FilterGroup"
                            IsChecked="{Binding FilterFound}"/>

                <!-- Фильтр: Лишние -->
                <RadioButton Grid.Column="3" Content="⚠️ Лишние" 
                            Margin="5,0,5,0" 
                            Foreground="{DynamicResource ThemeWarning}" FontSize="13"
                            GroupName="FilterGroup"
                            IsChecked="{Binding FilterExtra}"/>

                <!-- Фильтр: Пропущены -->
                <RadioButton Grid.Column="4" Content="❌ Пропущены" 
                            Margin="5,0,5,0" 
                            Foreground="{DynamicResource ThemeError}" FontSize="13"
                            GroupName="FilterGroup"
                            IsChecked="{Binding FilterMissing}"/>
            </Grid>
        </Border>

        <!-- ===== СПИСОК РЕЗУЛЬТАТОВ ===== -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeCardBg}" Margin="20" CornerRadius="12" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Список результатов -->
                <ListView Grid.Row="0" ItemsSource="{Binding FilteredResults}"
                          SelectedItem="{Binding SelectedResult}"
                          BorderThickness="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          MouseDoubleClick="ResultListView_MouseDoubleClick"
                          Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ResultItem}"
                                    BorderBrush="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                    Background="{DynamicResource ThemeCardBg}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка статуса -->
                                    <TextBlock Grid.Column="0" FontSize="20" Margin="0,0,10,0"
                                              Text="{Binding Status, Converter={StaticResource StatusToIconConverter}}"
                                              VerticalAlignment="Center"/>

                                    <!-- Информация об активе -->
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding AssetName, FallbackValue='Неизвестный актив'}" 
                                                  FontSize="14" FontWeight="SemiBold" 
                                                  Foreground="{DynamicResource ThemeTextPrimary}"/>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0">
                                            <Run Text="📋 "/>
                                            <Run Text="{Binding InventoryNumber, FallbackValue='—'}"/>
                                            <Run Text=" | "/>
                                            <Run Text="📍 "/>
                                            <Run Text="{Binding RfidTag, FallbackValue='—'}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Статус текстом -->
                                    <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                                              Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                              Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Пустое состояние -->
                <TextBlock Text="Сканируйте RFID-метки..." FontSize="16" 
                          Foreground="{DynamicResource ThemeTextSecondary}" 
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{Binding HasResults, Converter={StaticResource InverseBooleanConverter}}"/>
            </Grid>
        </Border>

        <!-- ===== КНОПКИ УПРАВЛЕНИЯ ===== -->
        <Border Grid.Row="3" Background="{DynamicResource ThemeCardBg}" 
                Padding="20" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ThemeBorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Основная строка кнопок -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Статус синхронизации -->
                    <TextBlock Grid.Column="0" Text="{Binding SyncStatus, FallbackValue='Готово'}" 
                              FontSize="13" Foreground="{DynamicResource ThemeTextSecondary}" 
                              VerticalAlignment="Center"/>

                    <!-- Ручной ввод -->
                    <Button Grid.Column="1" Content="✏️ Ввести вручную" 
                           Command="{Binding ManualEntryCommand}"
                           Background="#9C27B0" Foreground="White" Padding="15,8" Margin="10,0,5,0"
                           FontSize="13"/>

                    <!-- Пауза -->
                    <Button Grid.Column="2" Content="⏸ Пауза" Click="PauseButton_Click"
                           Background="#FF9800" Foreground="White" Padding="15,8" Margin="5,0,5,0"
                           FontSize="13" x:Name="PauseBtn"/>

                    <!-- Возобновить -->
                    <Button Grid.Column="3" Content="▶ Продолжить" Click="ResumeButton_Click"
                           Background="#4CAF50" Foreground="White" Padding="15,8" Margin="5,0,5,0"
                           FontSize="13" x:Name="ResumeBtn" Visibility="Collapsed"/>

                    <!-- Пропустить -->
                    <Button Grid.Column="4" Content="⏭ Пропустить" Click="SkipButton_Click"
                           Background="#9E9E9E" Foreground="White" Padding="15,8" Margin="5,0,5,0"
                           FontSize="13"/>

                    <!-- Завершить -->
                    <Button Grid.Column="5" Content="✅ Завершить" Click="FinishButton_Click"
                           Background="#2196F3" Foreground="White" Padding="20,8" Margin="5,0,0,0"
                           FontSize="14" FontWeight="Bold"/>
                </Grid>

                <!-- Дополнительная строка: экспорт и интеграция -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="📄 Экспорт отчёта" 
                           Command="{Binding ExportReportCommand}"
                           Background="#607D8B" Foreground="White" Padding="12,6" Margin="0,0,5,0"
                           FontSize="12" Visibility="{Binding CanExportReports, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="🔗 Синхронизировать с 1С" 
                           Command="{Binding SyncWith1CCommand}"
                           Background="#3F51B5" Foreground="White" Padding="12,6"
                           FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
