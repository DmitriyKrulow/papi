<Window x:Class="RfidScanner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RfidScanner.Views"
        Title="PAPI RFID Scanner" Height="850" Width="1280"
        MinHeight="700" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBg}">
    
    <Window.Resources>
        <Storyboard x:Key="PulseAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0.3" To="1.0" Duration="0:0:0.5"
                           AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <Style x:Key="SidebarNavItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" 
                                           FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="{TemplateBinding Content}" 
                                           FontSize="11" HorizontalAlignment="Center" 
                                           Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" 
                                        Value="{DynamicResource ThemeSidebarHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavActive" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSidebarActiveBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBright}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderThickness="3,0,0,0" BorderBrush="{DynamicResource ThemeAccentBright}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" 
                                           FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Text="{TemplateBinding Content}" 
                                           FontSize="11" HorizontalAlignment="Center" 
                                           Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" 
                                        Value="{DynamicResource ThemeSidebarHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernRow" TargetType="DataGridRow">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeWidgetInfoBg}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- БОКОВАЯ ПАНЕЛЬ -->
        <Border Grid.Column="0" Background="{DynamicResource ThemeSidebarBg}" 
                BorderThickness="0,0,1,0" BorderBrush="{DynamicResource ThemeBorderBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="8" Margin="0,12,0,8" HorizontalAlignment="Center">
                    <TextBlock Text="📡" FontSize="24" HorizontalAlignment="Center" 
                               VerticalAlignment="Center" Foreground="{DynamicResource ThemeAccentBright}"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button x:Name="NavInventoryBtn" Content="Инвентаризация" Tag="📋" 
                            Style="{StaticResource SidebarNavActive}" Click="NavInventory_Click" Margin="0,4,0,4"/>
                    <Button x:Name="NavSearchBtn" Content="Поиск" Tag="🔍" 
                            Style="{StaticResource SidebarNavItem}" Click="NavSearch_Click" Margin="0,4,0,4"/>
                    <Button x:Name="NavHistoryBtn" Content="История" Tag="📜" 
                            Style="{StaticResource SidebarNavItem}" Click="NavHistory_Click" Margin="0,4,0,4"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <Button x:Name="ThemeToggleBtn" Content="Тема" Tag="🌓" 
                            Style="{StaticResource SidebarNavItem}" Click="ThemeToggle_Click" Margin="0,4,0,4"
                            ToolTipService.ToolTip="Переключить тему"/>
                    <Button x:Name="SettingsBtn" Content="Настройки" Tag="⚙" 
                            Style="{StaticResource SidebarNavItem}" Click="SettingsButton_Click" Margin="0,4,0,4"
                            ToolTipService.ToolTip="Настройки"/>
                    <Button x:Name="LogoutBtn" Content="Выход" Tag="🚪" 
                            Style="{StaticResource SidebarNavItem}" Click="LogoutButton_Click" Margin="0,4,0,12"
                            Foreground="{DynamicResource ThemeError}" ToolTipService.ToolTip="Выйти"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ОСНОВНАЯ ОБЛАСТЬ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeHeaderBg}" 
                    Padding="20,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ThemeBorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ModeIndicator" Text="📡 RFID" 
                                       Foreground="{DynamicResource ThemeAccentBright}" FontSize="13" 
                                       FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <TextBlock x:Name="ConnectionStatus" Text="Проверка подключения..." 
                                       Foreground="{DynamicResource ThemeTextOnDark}" FontSize="13" 
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="SyncStatus" Text="Загрузка..." 
                                   Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" 
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Background="{DynamicResource ThemeSidebarActiveBg}" 
                                CornerRadius="16" Padding="12,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock x:Name="UserDisplay" Text="" 
                                           Foreground="{DynamicResource ThemeTextOnDark}" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Виджеты-сводки -->
            <Border x:Name="WidgetsPanel" Grid.Row="1" Background="Transparent" Visibility="Collapsed">
                <Border.Padding>
                    <Thickness Top="20" Bottom="12" Left="20" Right="20"/>
                </Border.Padding>
                <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource ThemeWidgetInfoBg}" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="🏢" FontSize="18" Margin="0,0,0,4"/>
                            <TextBlock x:Name="WidgetRooms" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                            <TextBlock Text="Помещений" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource ThemeWidgetSuccessBg}" CornerRadius="10" Padding="12" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="📦" FontSize="18" Margin="0,0,0,4"/>
                            <TextBlock x:Name="WidgetActive" Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeSuccess}"/>
                            <TextBlock Text="Инвентаризаций" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource ThemeWidgetErrorBg}" CornerRadius="10" Padding="12" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="⚠️" FontSize="18" Margin="0,0,0,4"/>
                            <TextBlock Text="0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ThemeError}"/>
                            <TextBlock Text="Ошибок" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource ThemeWidgetWarningBg}" CornerRadius="10" Padding="12" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="📊" FontSize="18" Margin="0,0,0,4"/>
                            <TextBlock Text="Готов" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                            <TextBlock Text="Статус сессии" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Область контента -->
            <Border Grid.Row="2" Background="{DynamicResource ThemeBg}">
                <Grid>
                    <views:RoomSelectorView x:Name="RoomSelectorHostView" Visibility="Visible"/>
                    <views:ScanView x:Name="ScanHostView" Visibility="Collapsed"/>
                    <views:SearchView x:Name="SearchHostView" Visibility="Collapsed"/>
                    <views:AuditView x:Name="AuditHostView" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
