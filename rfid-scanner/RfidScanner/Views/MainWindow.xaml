<Window x:Class="RfidScanner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RfidScanner.ViewModels"
        xmlns:views="clr-namespace:RfidScanner.Views"
        Title="PAPI RFID Scanner" Height="820" Width="1000"
        MinHeight="660" MinWidth="760"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="Button" x:Key="DangerButton">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#F44336"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#1976D2" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="ConnectionStatus" Text="Нет подключения" 
                              Foreground="White" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="SyncStatus" Text="Нет данных" 
                              Foreground="LightYellow" FontSize="12"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📜 История" Click="HistoryButton_Click" 
                           Background="#1565C0" Padding="10,5" Margin="0,0,5,0"/>
                    <Button Content="⚙ Настройки" Click="SettingsButton_Click" 
                           Background="#1565C0" Padding="10,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Вкладки режимов -->
        <TabControl x:Name="TabControl" Grid.Row="1" Margin="10" SelectionChanged="TabControl_SelectionChanged">
            <!-- Режим Инвентаризация -->
            <TabItem Header="📋 Инвентаризация" FontSize="16" x:Name="InventoryTab">
                <Grid>
                    <views:RoomSelectorView x:Name="RoomSelectorHostView" Visibility="Visible"/>
                    <views:ScanView x:Name="ScanHostView" Visibility="Collapsed"/>
                </Grid>
            </TabItem>

            <!-- Режим Поиск -->
            <TabItem Header="🔍 Поиск" FontSize="16">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Поиск -->
                    <Border Grid.Row="0" Background="White" BorderThickness="2" 
                           BorderBrush="#2196F3" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                    FontSize="20" Padding="10" x:Name="SearchBox"
                                    KeyDown="SearchBox_KeyDown"/>
                            <Button Grid.Column="1" Content="🔍" Click="SearchButton_Click" 
                                   Background="#2196F3" Foreground="White" Padding="20,10" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Результат -->
                    <Border Grid.Row="1" Background="White" BorderThickness="2" 
                            BorderBrush="#4CAF50" CornerRadius="10" Padding="30">
                        <StackPanel>
                            <TextBlock Text="{Binding SearchStatus, FallbackValue='Введите запрос'}" 
                                      FontSize="18" Foreground="Gray" Margin="0,0,0,20"/>
                            <TextBlock Text="{Binding SearchResult.InventoryNumber, FallbackValue='Не найдено'}" 
                                      FontSize="32" FontWeight="Bold" Foreground="Green" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding SearchResult.Name, FallbackValue=''}" 
                                      FontSize="20" Foreground="Gray" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding SearchResult.Location, FallbackValue=''}" 
                                      FontSize="16" Foreground="Orange" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding SearchResult.Responsible, FallbackValue=''}" 
                                      FontSize="16" Foreground="Blue" Margin="0,0,0,10"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Режим История -->
            <TabItem Header="📜 История" FontSize="16">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="🔄 Обновить" Click="RefreshHistory_Click" 
                           Background="#2196F3" Foreground="White" Padding="15,5" Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding History}" 
                             AutoGenerateColumns="False" IsReadOnly="True"
                             FontSize="14" GridLinesVisibility="Horizontal"
                             HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt}" Width="120"/>
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding Username}" Width="150"/>
                            <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="120"/>
                            <DataGridTextColumn Header="Помещение" Binding="{Binding RoomName}" Width="150"/>
                            <DataGridTextColumn Header="Детали" Binding="{Binding Details}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
